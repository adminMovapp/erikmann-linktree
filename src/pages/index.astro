---
import Layout from '@layouts/Layout.astro';
import { siteConfig } from '@utils/infoSite.jsx';
import SpotifyPlayer from '@components/SpotifyPlayer.astro';
import ShareButtons from '@components/ShareButtons.jsx';
import { FaYoutube, FaInstagram, FaFacebook, FaTiktok, FaTwitch, FaGooglePlay, FaApple, FaGlobe } from 'react-icons/fa';
import { SiThreads, SiX } from 'react-icons/si'; // Simple Icons

const { links, apps, website } = siteConfig;
const { logo, rostro } = siteConfig.assets;
const { name, description, description2, description3 } = siteConfig.site;

const iconMap = {
   FaYoutube,
   FaInstagram,
   FaFacebook,
   FaTiktok,
   FaTwitch,
   SiThreads,
   SiX,
   FaGooglePlay,
   FaApple,
};
---

<Layout title="LinkTree - ErikMann" description="LinkTree - ErikMann" type="website">
   <img src={rostro} alt="rostro" class="w-28 h-28 rounded-full mb-3 border-1 border-line mt-4 mx-auto" />
   <h1 class="text-font_color text-2xl font-bold mb-2 text-center">{name}</h1>
   <p class="text-font_color mb-2 text-center text-xs">{description}</p>
   <p class="text-font_color mb-2 text-center text-xs">{description2}</p>
   <p class="text-font_color mb-2 text-center text-xs">{description3}</p>

   <div class="w-full max-w-8xl mx-auto mt-8 flex flex-col gap-10">
      <!-- Links Section -->
      <div class="w-full flex flex-col gap-4">
         {
            links.map((link) => {
               const Icon = iconMap[link.icon];
               return (
                  <a
                     href={link.url}
                     target="_blank"
                     rel="noopener noreferrer"
                     class="grid grid-cols-[2.5rem_1fr_2.5rem] items-center gap-3 w-full bg-secondary/50 hover:bg-secondary/10 text-font_color font-semibold py-4 px-5 rounded-lg transition-all duration-200 shadow backdrop-blur-sm neon-outline"
                  >
                     <span class="flex items-center justify-center w-10 h-10">
                        <Icon size={26} aria-hidden="true" />
                     </span>
                     <span class="text-center text-base truncate">{link.name}</span>
                     <span aria-hidden="true"></span>
                  </a>
               );
            })
         }
      </div>

      <!-- Movapp Section -->
      <div class="w-full flex flex-col gap-4">
         <a
            href={website.url}
            target="_blank"
            rel="noopener noreferrer"
            class="grid grid-cols-[2.5rem_1fr_2.5rem] items-center gap-3 w-full bg-secondary/50 hover:bg-secondary/10 text-font_color font-semibold py-4 px-5 rounded-lg transition-all duration-200 shadow backdrop-blur-sm neon-outline"
         >
            <span class="flex items-center justify-center w-10 h-10">
               <FaGlobe size={24} aria-hidden="true" />
            </span>
            <span class="text-center text-base truncate">{website.name}</span>
            <span aria-hidden="true"></span>
         </a>
         <div class="grid grid-cols-2 gap-4">
            {
               apps.map((app) => {
                  const Icon = iconMap[app.icon];
                  return (
                     <a
                        href={app.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Descargar Movapp en ${app.store}`}
                        class="flex items-center justify-center gap-3 w-full min-w-0 bg-secondary/50 hover:bg-secondary/10 text-font_color py-3 px-3 sm:px-5 rounded-lg transition-all duration-200 shadow backdrop-blur-sm neon-outline"
                     >
                        <span class="flex items-center justify-center w-8 h-8 shrink-0">
                           <Icon size={26} aria-hidden="true" />
                        </span>
                        <span class="flex flex-col text-left leading-tight min-w-0">
                           <span class="text-[10px] sm:text-xs opacity-80 whitespace-nowrap">{app.label}</span>
                           <span class="text-sm sm:text-lg font-semibold whitespace-nowrap">{app.store}</span>
                        </span>
                     </a>
                  );
               })
            }
         </div>
      </div>

      <!-- Spotify and Share Buttons Section -->
      <div class="w-full flex flex-col items-center space-y-2">
         <div class="w-full max-w-lg flex justify-center">
            <SpotifyPlayer url={siteConfig.spotify.url} />
         </div>
         <div class="w-full max-w-lg">
            <ShareButtons client:load url={siteConfig.url} />
         </div>
      </div>
   </div>
</Layout>

<style>
   .neon-outline {
      position: relative;
      z-index: 0;
   }

   .neon-outline::before {
   }

   .neon-outline:hover::before {
      opacity: 1;
   }
</style>
